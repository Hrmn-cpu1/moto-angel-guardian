# ============================================================================
# Moto Anjo — variáveis de ambiente (APENAS NOMES + placeholders)
# Nunca comitar o .env real. Nenhum valor abaixo é verdadeiro.
# ============================================================================

# --- Supabase (backend: banco, auth, RLS, RPCs) -----------------------------
# Frontend (embutidas no bundle pelo Vite) — OBRIGATÓRIAS
VITE_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXX
VITE_SUPABASE_PROJECT_ID=seu-project-ref

# Servidor (server functions / SSR) — OBRIGATÓRIAS fora do Lovable
SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXX
SUPABASE_PROJECT_ID=seu-project-ref
# Usada só por src/integrations/supabase/client.server.ts (supabaseAdmin).
# NUNCA expor no frontend. No Lovable Cloud é injetada automaticamente.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-chave-de-servico-aqui

# --- Google Maps ------------------------------------------------------------
# Frontend. Chave própria do projeto (prioritária em src/components/RealMap.tsx).
# Restrita por referrer HTTP: precisa listar https://moto-angel-guardian.lovable.app/*
# e o domínio customizado, se houver. Maps JavaScript API deve estar ativada
# e o projeto Google Cloud precisa de billing habilitado.
VITE_GOOGLE_MAPS_BROWSER_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Fallback gerenciado pelo conector do Lovable (só funciona em *.lovable.app).
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=channel-id-opcional

# --- WhatsApp Cloud API (Meta) — servidor, src/lib/sos.server.ts ------------
# Opcionais: sem elas o SOS continua funcionando e cai no envio manual wa.me.
WHATSAPP_ACCESS_TOKEN=EAAG...token-da-meta
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# --- Lovable AI Gateway / conectores (opcional) -----------------------------
LOVABLE_API_KEY=lov_XXXXXXXXXXXXXXXX

# --- SOS durável: DESLIGADO por padrão ---------------------------------------
# true apenas após configurar o provedor e o consumidor agendado.
SOS_DELIVERY_ENABLED=false
# Segredo aleatório com pelo menos 32 caracteres; mesmo valor no Vault do scheduler.
SOS_DISPATCH_SECRET=
# Versão da Graph API suportada pela conta, explicitamente verificada no deploy.
WHATSAPP_GRAPH_VERSION=
# Template de utilidade aprovado, BODY com quatro parâmetros posicionais:
# 1 nome; 2 URL Google Maps; 3 data/hora São Paulo; 4 telefone do motociclista.
WHATSAPP_SOS_TEMPLATE_NAME=
WHATSAPP_SOS_TEMPLATE_LANGUAGE=pt_BR
# App Secret da Meta para HMAC de POSTs; verify token para GET de inscrição.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Callback: /api/public/whatsapp-webhook; inscrever campo messages.
# Scheduler: supabase/operations/schedule-sos.sql instala job inicialmente desativado.

# --- Provedor automático: meta (padrão) ou evolution --------------------------
SOS_DELIVERY_PROVIDER=meta
# OBRIGATÓRIO para Evolution. ISO com timezone do instante de ativação.
# Nunca retroceder este corte para liberar a fila antiga. Ex.: 2026-09-08T20:00:00Z
SOS_DELIVERY_NOT_BEFORE=
# Evolution API 2.x; todos os valores abaixo existem SOMENTE no servidor.
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# POST sendLocation usa {number,latitude,longitude,name,address}; key.id confirma aceite.
# Uma localização nativa com aviso SOS, sem texto separado nem link de mapa.
# Sem recibo autenticado do provedor, o app não marca Evolution como entregue.
